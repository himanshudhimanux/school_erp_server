{
  "name": "school-erp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant School ERP REST API",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "db:indexes": "node scripts/sync-indexes.js",
    "seed:load": "node scripts/seed-load.js",
    "load-test": "node scripts/load-test.js",
    "create-superadmin": "node scripts/create-superadmin.js"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  }
