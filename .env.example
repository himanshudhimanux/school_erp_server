NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/school_erp
# Use a long random value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
# Number of reverse proxies in front of the API (1 behind Nginx)
TRUST_PROXY=0
# COOKIE_SECURE=true   (defaults to true in production)
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Set true in production: refuse to start without a replica set (needed for fee transactions)
REQUIRE_TRANSACTIONS=false
# Email through Resend (https://resend.com). Optional in development: without a key, emails are logged instead of sent.
# MAIL_FROM must use a domain you have verified in Resend (Domains page).
RESEND_API_KEY=
MAIL_FROM=School ERP <no-reply@example.com>
# Encryption key for stored secrets (school payment gateway keys). Required in production.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
RAZORPAY_API_URL=https://api.razorpay.com/v1
# Background jobs: fee reminders and late fees (hourly)
JOBS_ENABLED=true
# API requests allowed per client IP per minute
RATE_LIMIT_PER_MINUTE=300
# Sign-in / password-reset attempts allowed per client IP per 15 minutes
AUTH_RATE_LIMIT_PER_15_MIN=30
# Public URL of this API, used for SMS/WhatsApp delivery receipts (Twilio status callbacks)
PUBLIC_API_URL=
# SMS / WhatsApp through Twilio (optional: a channel is offered only when its sender is set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# WhatsApp sender, e.g. +14155238886 (an approved WhatsApp Business number)
TWILIO_WHATSAPP_FROM=
SMS_DEFAULT_COUNTRY_CODE=91
# Push notifications through Firebase Cloud Messaging: path to the service-account JSON file
# (Firebase console > Project settings > Service accounts), or that JSON base64-encoded
FCM_SERVICE_ACCOUNT=
# Seed script (development only)
SEED_SUPERADMIN_EMAIL=superadmin@erp.local
SEED_PASSWORD=Password@123
